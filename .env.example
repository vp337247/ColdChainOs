# =========================================================================
# ColdChainOS Environment Template (Copy to .env)
# =========================================================================

# Database Configuration (PostgreSQL 16)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5438/coldchainos_db?prepareThreshold=5&reWriteBatchedInserts=true
SPRING_DATASOURCE_USERNAME=coldchain_admin
SPRING_DATASOURCE_PASSWORD=your_db_password_here
DB_POOL_MAX=25
DB_POOL_MIN_IDLE=5

# Distributed In-Memory Cache (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6389
REDIS_PASSWORD=

# Event Streaming Broker (Apache Kafka 3.7 KRaft)
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# Security & Authentication (Spring Security 6 + JJWT 0.12.5)
# Generate a secure 256-bit Base64-encoded secret key
COLDCHAIN_SECURITY_JWT_SECRET=c2VjdXJlX3Byb2R1Y3Rpb25faG1hY19zaGEyNTZfc2VjcmV0X2tleV9leHRyZW1lbHlfbG9uZ19zdHJpbmc=
JWT_EXPIRATION_MINUTES=60

# Google Gemini AI LLM Configuration (LangChain4j)
# Obtain your API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-flash
GEMINI_TEMPERATURE=0.1

# Observability & Distributed Tracing
TRACING_PROBABILITY=1.0

# Application Server
PORT=8080
SPRING_PROFILES_ACTIVE=prod
